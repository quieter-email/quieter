{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quieter-local-background",
  "main": "packages/cloudflare/src/local-worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "LocalMailStorage",
      "bucket_name": "quieter-local-mail",
      "remote": false,
    },
  ],
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  "durable_objects": {
    "bindings": [
      { "name": "MailLiveUser", "class_name": "MailLiveUser" },
      {
        "name": "GmailLiveSyncMailboxV2",
        "class_name": "GmailLiveSyncMailboxV2",
      },
    ],
  },
  // The pre-revert class was deleted by production migration v2, so local
  // development starts a fresh tag for the re-created class.
  "migrations": [
    { "tag": "v2", "new_sqlite_classes": ["GmailLiveSyncMailboxV2"] },
    { "tag": "mail-user-v1", "new_sqlite_classes": ["MailLiveUser"] },
  ],
  "queues": {
    "producers": [
      { "binding": "GmailPsQueue", "queue": "quieter-local-gmail" },
    ],
    "consumers": [
      {
        "queue": "quieter-local-gmail",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 5,
        "dead_letter_queue": "quieter-local-gmail-failed",
      },
    ],
  },
}
