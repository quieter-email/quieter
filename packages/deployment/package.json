{
  "name": "@quieter/deployment",
  "private": true,
  "type": "module",
  "exports": {
    "./controller": "./src/controller.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "build:web": "node --conditions=development src/web-release-build-cli.ts",
    "upload:source-maps": "node --conditions=development src/source-map-upload-cli.ts",
    "archive": "node --conditions=development src/archive-cli.ts",
    "artifact": "node --conditions=development src/artifact-cli.ts",
    "verify:archive": "node --conditions=development src/verify-archive-proof.ts",
    "verify:controller": "node --conditions=development src/verify-controller-proof.ts",
    "verify:proof": "node --conditions=development src/verify-live-proof.ts",
    "verify:upload": "node --conditions=development src/verify-upload-proof.ts",
    "verify:web": "node --conditions=development src/verify-web-proof.ts",
    "release": "node --conditions=development src/cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@quieter/env": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@quieter/config": "workspace:*",
    "@sentry/cli": "2.58.5",
    "@types/node": "catalog:",
    "magic-string": "0.30.21",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  }
}
