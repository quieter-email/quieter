{
  "name": "@quieter/management-cli",
  "version": "0.0.0",
  "private": true,
  "description": "Explicit session-authenticated Quieter management commands.",
  "license": "MIT",
  "bin": {
    "quieter-management": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "vp pack"
  },
  "devDependencies": {
    "@quieter/config": "link:../config",
    "@quieter/management-sdk": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  }
}
