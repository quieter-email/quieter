{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quieter-mail-maintenance-local",
  "main": "src/mail-maintenance-worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [
    { "binding": "LocalMailStorage", "bucket_name": "quieter-local-mail" },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MailMaintenanceScheduler",
        "class_name": "MailMaintenanceScheduler",
      },
    ],
  },
  "migrations": [
    {
      "tag": "maintenance-v1",
      "new_sqlite_classes": ["MailMaintenanceScheduler"],
    },
  ],
}
