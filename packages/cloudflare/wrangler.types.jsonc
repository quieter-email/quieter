{
  // Type generation only. SST remains the sole production deployment authority.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quieter-gmail-realtime-types",
  "main": "src/type-generation-worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "services": [
    {
      "binding": "MAIL_MAINTENANCE",
      "service": "quieter-mail-maintenance-types",
    },
    {
      "binding": "GmailProcessingWorker",
      "service": "quieter-gmail-processing-types",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "MailDispatchRepairQueue",
        "queue": "quieter-types-mail-dispatch-repair",
      },
      {
        "binding": "GmailMailboxAutomationQueue0",
        "queue": "quieter-types-gmail-mailbox-automation-0",
      },
      {
        "binding": "GmailMailboxAutomationQueue1",
        "queue": "quieter-types-gmail-mailbox-automation-1",
      },
      {
        "binding": "GmailMailboxAutomationQueue2",
        "queue": "quieter-types-gmail-mailbox-automation-2",
      },
      {
        "binding": "GmailMailboxAutomationQueue3",
        "queue": "quieter-types-gmail-mailbox-automation-3",
      },
      {
        "binding": "GmailMailboxFreshQueue0",
        "queue": "quieter-types-gmail-mailbox-fresh-0",
      },
      {
        "binding": "GmailMailboxFreshQueue1",
        "queue": "quieter-types-gmail-mailbox-fresh-1",
      },
      {
        "binding": "GmailMailboxFreshQueue2",
        "queue": "quieter-types-gmail-mailbox-fresh-2",
      },
      {
        "binding": "GmailMailboxFreshQueue3",
        "queue": "quieter-types-gmail-mailbox-fresh-3",
      },
      {
        "binding": "GmailMailboxCatchupQueue0",
        "queue": "quieter-types-gmail-mailbox-catchup-0",
      },
      {
        "binding": "GmailMailboxCatchupQueue1",
        "queue": "quieter-types-gmail-mailbox-catchup-1",
      },
      {
        "binding": "GmailMailboxCatchupQueue2",
        "queue": "quieter-types-gmail-mailbox-catchup-2",
      },
      {
        "binding": "GmailMailboxCatchupQueue3",
        "queue": "quieter-types-gmail-mailbox-catchup-3",
      },
      {
        "binding": "GmailProcessingQueue",
        "queue": "quieter-gmail-processing-types",
      },
      {
        "binding": "GmailFreshProcessingQueue",
        "queue": "quieter-gmail-fresh-processing-types",
      },
      {
        "binding": "GmailCatchupProcessingQueue",
        "queue": "quieter-gmail-catchup-processing-types",
      },
    ],
  },
  "vars": {
    "BETTER_AUTH_URL": "https://quieter.example",
    "CONNECTOR_TOKEN_ENCRYPTION_KEY": "connector-token-key",
    "GMAIL_TOKEN_ENCRYPTION_KEY": "gmail-token-key",
    "GMAIL_TOKEN_ENCRYPTION_KEY_CURRENT": "gmail-token-key-current",
    "GMAIL_PUBSUB_PUSH_AUDIENCE": "https://audience.invalid/gmail/pubsub",
    "GMAIL_PUBSUB_PUSH_SERVICE_ACCOUNT": "gmail-push@example.invalid",
    "GMAIL_PUBSUB_SUBSCRIPTION": "projects/example/subscriptions/gmail",
    "GMAIL_PUBSUB_TOPIC": "projects/example/topics/gmail",
    "GOOGLE_CALENDAR_CLIENT_ID": "calendar-client-id",
    "GOOGLE_CALENDAR_CLIENT_SECRET": "calendar-client-secret",
    "GOOGLE_GMAIL_CLIENT_ID": "gmail-client-id",
    "GOOGLE_GMAIL_CLIENT_SECRET": "gmail-client-secret",
    "LINEAR_CLIENT_ID": "linear-client-id",
    "LINEAR_CLIENT_SECRET": "linear-client-secret",
    "OPENROUTER_API_KEY": "openrouter-key",
    "POLAR_ACCESS_TOKEN": "polar-access-token",
    "POLAR_ORGANIZATION_ID": "organization-id",
    "POLAR_SANDBOX": "true",
    "QUIETER_GMAIL_AI_AUTOMATION_ENABLED": "true",
    "SENTRY_ENVIRONMENT": "test",
    "SST_RESOURCE_GmailLiveSyncTokenSecret": "{\"value\":\"live-sync-secret\"}",
    "SST_RESOURCE_SentryDsn": "{\"value\":\"https://examplePublicKey@o0.ingest.sentry.io/0\"}",
  },
  "hyperdrive": [
    {
      "binding": "AppDatabaseV2",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://test:test@localhost:5432/quieter_dev",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "GmailProjectQuota", "class_name": "GmailProjectQuota" },

      {
        "name": "GmailMailboxScheduler",
        "class_name": "GmailMailboxScheduler",
      },
      {
        "name": "GmailFreshExecutor",
        "class_name": "GmailFreshExecutor",
      },
      {
        "name": "MailMaintenanceScheduler",
        "class_name": "MailMaintenanceScheduler",
      },
      { "name": "MailLiveUser", "class_name": "MailLiveUser" },
      { "name": "ReminderMailbox", "class_name": "ReminderMailbox" },
      { "name": "ScheduledSend", "class_name": "ScheduledSend" },
      { "name": "MailSnooze", "class_name": "MailSnooze" },
      {
        "name": "GmailLiveSyncMailboxV2",
        "class_name": "GmailLiveSyncMailboxV2",
      },
    ],
  },
  "migrations": [
    { "tag": "fresh-v1", "new_sqlite_classes": ["GmailFreshExecutor"] },
    {
      "tag": "mailbox-scheduler-v1",
      "new_sqlite_classes": ["GmailMailboxScheduler"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["GmailLiveSyncMailboxV2"],
    },
    {
      "tag": "maintenance-v1",
      "new_sqlite_classes": ["MailMaintenanceScheduler"],
    },
    { "tag": "mail-user-v1", "new_sqlite_classes": ["MailLiveUser"] },
    { "tag": "reminders-v1", "new_sqlite_classes": ["ReminderMailbox"] },
    { "tag": "scheduled-send-v1", "new_sqlite_classes": ["ScheduledSend"] },
    { "tag": "gmail-quota-v1", "new_sqlite_classes": ["GmailProjectQuota"] },
    { "tag": "mail-snooze-v1", "new_sqlite_classes": ["MailSnooze"] },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
      "persist": true,
    },
  },
}
