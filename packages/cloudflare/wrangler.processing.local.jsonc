{
  // Auxiliary Worker in dev:workers. No listening port or public deployment.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quieter-local-gmail-processing",
  "main": "src/gmail-processing-worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "queues": {
    "producers": [
      {
        "binding": "GmailMailboxAutomationQueue0",
        "queue": "quieter-local-gmail-mailbox-automation-0",
      },
      {
        "binding": "GmailMailboxAutomationQueue1",
        "queue": "quieter-local-gmail-mailbox-automation-1",
      },
      {
        "binding": "GmailMailboxAutomationQueue2",
        "queue": "quieter-local-gmail-mailbox-automation-2",
      },
      {
        "binding": "GmailMailboxAutomationQueue3",
        "queue": "quieter-local-gmail-mailbox-automation-3",
      },
      {
        "binding": "GmailMailboxFreshQueue0",
        "queue": "quieter-local-gmail-mailbox-fresh-0",
      },
      {
        "binding": "GmailMailboxFreshQueue1",
        "queue": "quieter-local-gmail-mailbox-fresh-1",
      },
      {
        "binding": "GmailMailboxFreshQueue2",
        "queue": "quieter-local-gmail-mailbox-fresh-2",
      },
      {
        "binding": "GmailMailboxFreshQueue3",
        "queue": "quieter-local-gmail-mailbox-fresh-3",
      },
      {
        "binding": "GmailMailboxCatchupQueue0",
        "queue": "quieter-local-gmail-mailbox-catchup-0",
      },
      {
        "binding": "GmailMailboxCatchupQueue1",
        "queue": "quieter-local-gmail-mailbox-catchup-1",
      },
      {
        "binding": "GmailMailboxCatchupQueue2",
        "queue": "quieter-local-gmail-mailbox-catchup-2",
      },
      {
        "binding": "GmailMailboxCatchupQueue3",
        "queue": "quieter-local-gmail-mailbox-catchup-3",
      },
    ],
    "consumers": [
      {
        "queue": "quieter-local-gmail-mailbox-automation-0",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_concurrency": 1,
      },
      {
        "queue": "quieter-local-gmail-mailbox-automation-1",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_concurrency": 1,
      },
      {
        "queue": "quieter-local-gmail-mailbox-automation-2",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_concurrency": 1,
      },
      {
        "queue": "quieter-local-gmail-mailbox-automation-3",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_concurrency": 1,
      },
      {
        "queue": "quieter-local-gmail-mailbox-fresh-0",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_batch_timeout": 0,
      },
      {
        "queue": "quieter-local-gmail-mailbox-fresh-1",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_batch_timeout": 0,
      },
      {
        "queue": "quieter-local-gmail-mailbox-fresh-2",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_batch_timeout": 0,
      },
      {
        "queue": "quieter-local-gmail-mailbox-fresh-3",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_batch_timeout": 0,
      },
      {
        "queue": "quieter-local-gmail-mailbox-catchup-0",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_batch_timeout": 0,
      },
      {
        "queue": "quieter-local-gmail-mailbox-catchup-1",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_batch_timeout": 0,
      },
      {
        "queue": "quieter-local-gmail-mailbox-catchup-2",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_batch_timeout": 0,
      },
      {
        "queue": "quieter-local-gmail-mailbox-catchup-3",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_batch_timeout": 0,
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      { "name": "GmailProjectQuota", "class_name": "GmailProjectQuota" },

      {
        "name": "GmailMailboxScheduler",
        "class_name": "GmailMailboxScheduler",
      },
      {
        "name": "GmailFreshExecutor",
        "class_name": "GmailFreshExecutor",
      },
      {
        "name": "MailLiveUser",
        "class_name": "MailLiveUser",
        "script_name": "quieter-local-background",
      },
    ],
  },
  "migrations": [
    { "tag": "fresh-v1", "new_sqlite_classes": ["GmailFreshExecutor"] },
    {
      "tag": "mailbox-scheduler-v1",
      "new_sqlite_classes": ["GmailMailboxScheduler"],
    },
    { "tag": "gmail-quota-v1", "new_sqlite_classes": ["GmailProjectQuota"] },
  ],
}
