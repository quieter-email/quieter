{
  "name": "@quieter/cloudflare",
  "private": true,
  "type": "module",
  "exports": {
    "./compatibility-date": "./src/compatibility-date.ts"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.local.jsonc --config wrangler.processing.local.jsonc --persist-to ../../.wrangler/state",
    "cf-typecheck": "wrangler types worker-configuration.d.ts --config wrangler.types.jsonc --env-file wrangler.types.env --strict-vars false --check",
    "cf-typegen": "wrangler types worker-configuration.d.ts --config wrangler.types.jsonc --env-file wrangler.types.env --strict-vars false",
    "check:compatibility-date": "node scripts/sync-compatibility-date.ts --check",
    "sync:compatibility-date": "node scripts/sync-compatibility-date.ts",
    "test:workers": "vp exec vitest run --config worker-tests.config.ts",
    "write:build-wrangler": "node scripts/write-build-wrangler.ts",
    "check:bundles": "vp run @quieter/env#build && vp run @quieter/observability#build && node scripts/check-handler-bundles.ts"
  },
  "dependencies": {
    "@quieter/database": "workspace:*",
    "@quieter/env": "workspace:*",
    "@quieter/mail": "workspace:*",
    "@quieter/observability": "workspace:*",
    "@quieter/orpc": "workspace:*",
    "@sentry/cloudflare": "catalog:",
    "drizzle-orm": "catalog:",
    "jose": "6.2.18",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@quieter/config": "workspace:*",
    "@types/node": "catalog:",
    "cf": "1.0.0-rc.2",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
