{
  "name": "@quieter/cloudflare",
  "private": true,
  "type": "module",
  "exports": {
    "./compatibility-date": "./src/compatibility-date.ts"
  },
  "scripts": {
    "dev": "cf dev --persist-to ../../.wrangler/state",
    "cf-typecheck": "wrangler types worker-configuration.d.ts --config wrangler.types.jsonc --strict-vars false --check",
    "cf-typegen": "wrangler types worker-configuration.d.ts --config wrangler.types.jsonc --strict-vars false",
    "check:compatibility-date": "node scripts/sync-compatibility-date.ts --check",
    "sync:compatibility-date": "node scripts/sync-compatibility-date.ts",
    "test:workers": "vp exec vitest run --config worker-tests.config.ts",
    "write:build-wrangler": "node scripts/write-build-wrangler.ts",
    "check:bundles": "node scripts/check-handler-bundles.ts"
  },
  "dependencies": {
    "@quieter/database": "workspace:*",
    "@quieter/env": "workspace:*",
    "@quieter/mail": "workspace:*",
    "@quieter/observability": "workspace:*",
    "@quieter/orpc": "workspace:*",
    "@sentry/cloudflare": "catalog:",
    "drizzle-orm": "catalog:",
    "jose": "6.2.12",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@quieter/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/browser-preview": "4.1.11",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "@vitest/ui": "4.1.11",
    "@vitest/utils": "4.1.11",
    "cf": "1.0.0-beta.10",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "4.1.11",
    "wrangler": "catalog:"
  }
}
