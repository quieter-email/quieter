{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quieter-release-durable-local",
  "main": "../deployment/src/release-durable-probe.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "PROBE_GENERATION": "baseline",
    "PROBE_TOKEN": "test-only-release-proof-token-000000000000",
    "PROBE_VERSION": { "id": "00000000-0000-4000-8000-000000000269" },
  },
  "durable_objects": {
    "bindings": [{ "name": "ReleaseCounter", "class_name": "ReleaseCounter" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReleaseCounter"] }],
}
