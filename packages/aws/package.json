{
  "name": "@quieter/aws",
  "private": true,
  "type": "module",
  "exports": {
    "./inbound": "./src/inbound.ts",
    "./outbound-feedback": "./src/outbound-feedback.ts",
    "./outbound": "./src/outbound.ts",
    "./receipt": "./src/receipt.ts"
  },
  "scripts": {
    "backfill:managed-mail-r2": "node --env-file-if-exists=../../.env.local scripts/backfill-managed-mail-r2.ts",
    "dev": "node --env-file-if-exists=../../.env.local --env-file-if-exists=../../.env.sst.local ../../scripts/run-sst.ts dev --config sst.config.ts --stage mail-dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/client-sesv2": "catalog:",
    "@quieter/billing": "workspace:*",
    "@quieter/database": "workspace:*",
    "@quieter/env": "workspace:*",
    "@quieter/observability": "workspace:*",
    "@quieter/orpc": "workspace:*",
    "@sentry/node": "catalog:",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@quieter/config": "workspace:*",
    "@types/node": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
