# Normal local development. Persistent secrets belong in SST local-<name>.
# Copy to .env.local, then: vp run secrets:dev pull local-<name>
# Never copy production credentials here. See docs/development.md.
QUIETER_DEPLOYMENT_ENV="local"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_APP_NAME="quieter"
QUIETER_AUTH_MAIL_MODE="console"
QUIETER_AUTH_MAIL_SENDER="auth@quieter.email"

# Existing PlanetScale cluster, separate logical database and roles.
# Replace credentials through SST. Keep verify-full and these distinct ports.
QUIETER_LOCAL_PLANETSCALE_HOST="eu-central-1.pg.psdb.cloud"
DATABASE_URL="postgresql://dev-app:replace-me@eu-central-1.pg.psdb.cloud:6432/quieter_dev?sslmode=verify-full"
DATABASE_MIGRATION_URL="postgresql://dev-migrator:replace-me@eu-central-1.pg.psdb.cloud:5432/quieter_dev?sslmode=verify-full"

# Development SST secrets, never production fallback:
# BETTER_AUTH_SECRET=
# APP_SITE_PASSWORD=
# GOOGLE_AUTH_CLIENT_ID=
# GOOGLE_AUTH_CLIENT_SECRET=
# GOOGLE_GMAIL_CLIENT_ID=
# GOOGLE_GMAIL_CLIENT_SECRET=
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
# CONNECTOR_TOKEN_ENCRYPTION_KEY=
# GMAIL_TOKEN_ENCRYPTION_KEY=
# GMAIL_TOKEN_ENCRYPTION_KEY_CURRENT=
# Identity callback: http://localhost:3000/api/auth/callback/google
# Gmail callback: http://localhost:3000/api/gmail/callback
# Calendar and Linear callback: http://localhost:3000/api/connectors/callback

# Native local queues and Durable Objects. dev:setup creates missing secrets.
GMAIL_LIVE_SYNC_URL="ws://127.0.0.1:8787/gmail/live"
# GMAIL_LIVE_SYNC_TOKEN_SECRET=
# QUIETER_LOCAL_WORKER_TOKEN=
GMAIL_PUBSUB_TOPIC="projects/quietr-project/topics/quieter-gmail"
# Give each independent consumer its own pull subscription:
# GMAIL_PUBSUB_SUBSCRIPTION="projects/quietr-project/subscriptions/quieter-gmail-local-yourname"
QUIETER_LOCAL_PROVIDER_MODE="observe"
QUIETER_LOCAL_GMAIL_WATCH_OWNER="production"
# Dedicated test mailbox or explicitly verified production handoff only:
# QUIETER_LOCAL_PROVIDER_MODE="write"
# QUIETER_LOCAL_GMAIL_WRITE_ACCOUNTS="your-dedicated-test-account@gmail.com"
# QUIETER_LOCAL_CALENDAR_WRITE_ACCOUNTS="your-dedicated-test-account@gmail.com"
# QUIETER_LOCAL_LINEAR_WRITES="true"
# QUIETER_LOCAL_GMAIL_WATCH_OWNER="local"

# Use a separate capped OpenRouter key. Background AI is explicitly opt-in.
QUIETER_GMAIL_AI_AUTOMATION_ENABLED="false"
# OPENROUTER_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_API_TOKEN=
# VITE_LOGO_DEV_PUBLISHABLE_KEY=

# Turn bypass off when testing real sandbox entitlements and checkout.
QUIETER_LOCAL_BILLING_BYPASS="true"
POLAR_SANDBOX="true"
# POLAR_ACCESS_TOKEN=
# POLAR_ORGANIZATION_ID=
# POLAR_PRODUCT_MANAGED_ID=
# POLAR_PRODUCT_PRO_ID=
# POLAR_WEBHOOK_SECRET=
# Native CLI target: http://localhost:3000/api/auth/polar/webhooks

# Telemetry stays off, even if a browser key was inherited.
# Use development projects only when explicitly testing telemetry.
VITE_QUIETER_LOCAL_TELEMETRY="false"
# VITE_QUIETER_LOCAL_TELEMETRY="true"
# VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
# VITE_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
# VITE_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_ENVIRONMENT="development"

# SST bootstrap belongs in ignored .env.sst.local:
# AWS_PROFILE="your-sso-profile"
# AWS_REGION="eu-central-1"
# Run aws sso login --profile your-sso-profile when its session expires.
# Production SES, R2, IAM, push endpoints and deploy credentials are excluded.
