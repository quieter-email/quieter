{
  "expo": {
    "name": "Quieter",
    "slug": "quieter",
    "scheme": "quieter",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "email.quieter.app",
      "supportsTablet": true
    },
    "android": {
      "package": "email.quieter.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#eeeef0",
          "dark": {
            "backgroundColor": "#0e0f10"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
