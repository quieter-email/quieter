{
  "name": "@quieter/workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "billing:sync-credit-usage-polar": "vp run @quieter/billing#credit-usage:sync",
    "billing:sync-polar": "vp run @quieter/billing#catalog:sync",
    "build": "vp run -r build",
    "check:boundaries": "vp run @quieter/aws#check:boundaries",
    "check:bundles": "vp run @quieter/aws#check:bundles && vp run @quieter/cloudflare#check:bundles",
    "check:cloudflare": "vp run @quieter/cloudflare#check:compatibility-date",
    "db:check": "vp run @quieter/database#db:check",
    "db:deploy": "vp run @quieter/database#db:deploy",
    "db:generate": "vp run @quieter/database#db:generate",
    "db:migrate": "vp run @quieter/database#db:migrate",
    "db:push": "vp run @quieter/database#db:push",
    "db:test-migrations": "vp run @quieter/database#db:test-migrations",
    "dev": "vp dev apps/web --port 3000 --configLoader native",
    "dev:cloud": "vp run @quieter/env#doctor && vp run --parallel --filter=@quieter/web --filter=@quieter/aws dev",
    "dev:mail": "vp run @quieter/env#doctor && vp run @quieter/aws#dev",
    "env:doctor": "vp run @quieter/env#doctor",
    "generate:assets": "node scripts/generate-web-assets.ts",
    "prepare": "vp config --no-agent",
    "sst": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.sst.local scripts/run-sst.ts"
  },
  "devDependencies": {
    "@quieter/cloudflare": "workspace:*",
    "@quieter/env": "workspace:*",
    "@resvg/resvg-js-cli": "2.6.2-beta.1",
    "@types/node": "catalog:",
    "eslint-plugin-sonarjs": "4.2.0",
    "fast-xml-parser": "catalog:",
    "oxlint-plugin-react-doctor": "0.7.1",
    "sst": "^4.17.1",
    "tw-animate-css": "^1.4.0",
    "ultracite": "7.10.1",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.34.5"
}
